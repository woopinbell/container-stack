[mysqld]
# [INTV:ARCH] 컨테이너 네트워크 안의 다른 서비스(wordpress)가 접속해야 하므로 localhost가 아니라 모든
# 인터페이스에서 수신 — 실제 외부 노출 차단은 docker-compose.yml의 backend 네트워크(internal: true)가
# 담당하는 계층 분리 설계.
bind-address=0.0.0.0
port=3306
datadir=/var/lib/mysql-volume/data
socket=/run/mysqld/mysqld.sock
pid-file=/run/mysqld/mysqld.pid

# [INTV:PERF] 접속해오는 클라이언트 IP를 호스트명으로 역질의(reverse DNS)하지 않음 — Docker 네트워크에는
# 그런 DNS 레코드가 없기도 하고, 매 접속마다 DNS 조회를 건너뛰어 연결 속도도 빨라진다.
skip-name-resolve
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
# [INTV:PERF] InnoDB가 테이블/인덱스 데이터를 메모리에 캐싱하는 버퍼 풀 크기 — 이 컨테이너에 배정된
# mem_limit(512m, docker-compose.yml) 안에서 여유를 두고 잡은 값.
# - [TRAP] 이 값을 컨테이너 mem_limit과 무관하게 크게 잡으면, InnoDB가 그 크기만큼 메모리를 확보하려다
#   컨테이너의 cgroup 메모리 상한에 걸려 OOM killer에 의해 죽는다. 항상 컨테이너 상한보다 여유 있게 잡을 것.
innodb_buffer_pool_size=128M
max_connections=80

[client]
socket=/run/mysqld/mysqld.sock
default-character-set=utf8mb4
